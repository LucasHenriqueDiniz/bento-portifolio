# API Server URL
# Default: http://localhost:3000
VITE_API_URL=http://localhost:3000

# World of Warcraft: Forever (Pages secrets; .dev.vars locally)
# Used for: the WoW character card, through the Battle.net API
BATTLENET_CLIENT_ID=your_battlenet_client_id_here
BATTLENET_CLIENT_SECRET=your_battlenet_client_secret_here
# Optional: "name-surname" and region (us, eu, kr, tw)
WOW_CHARACTER=pequeno-ibuprofeno
WOW_REGION=us
